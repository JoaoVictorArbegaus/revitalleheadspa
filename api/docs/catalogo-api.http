### 5. Criar reserva pública
POST {{baseUrl}}/api/v1/publico/agendamentos
Content-Type: application/json
Chave-Idempotencia: {{chavePublica}}

{
  "servicoId": "{{servicoId}}",
  "inicioEm": "{{segunda}}T09:00:00-03:00",
  "cliente": {
    "nome": "Cliente Exemplo",
    "celular": "{{celularPublico}}"
  },
  "versaoAvisoPrivacidade": "{{versaoAvisoPrivacidade}}",
  "cienteAvisoPrivacidade": true
}

> {%
client.test("Reserva publica", function () {
  client.assert(response.status === 201, "Esperado 201");
  client.assert(response.body.estado === "CONFIRMADO", "Esperado CONFIRMADO");
  client.assert(response.body.agendamentoId === undefined, "Sem identificador publico");
});
%}

### Repetir a criação com a mesma chave devolve o mesmo resultado
POST {{baseUrl}}/api/v1/publico/agendamentos
Content-Type: application/json
Chave-Idempotencia: {{chavePublica}}

{
  "servicoId": "{{servicoId}}",
  "inicioEm": "{{segunda}}T09:00:00-03:00",
  "cliente": {
    "nome": "Cliente Exemplo",
    "celular": "{{celularPublico}}"
  },
  "versaoAvisoPrivacidade": "{{versaoAvisoPrivacidade}}",
  "cienteAvisoPrivacidade": true
}

> {%
client.test("Retentativa idempotente", function () {
  client.assert(response.status === 201, "Esperado 201");
});
%}

### Reutilizar a chave com conteúdo diferente responde 409
POST {{baseUrl}}/api/v1/publico/agendamentos
Content-Type: application/json
Chave-Idempotencia: {{chavePublica}}

{
  "servicoId": "{{servicoId}}",
  "inicioEm": "{{segunda}}T09:15:00-03:00",
  "cliente": {
    "nome": "Cliente Exemplo",
    "celular": "{{celularPublico}}"
  },
  "versaoAvisoPrivacidade": "{{versaoAvisoPrivacidade}}",
  "cienteAvisoPrivacidade": true
}

> {%
client.test("Chave divergente", function () {
  client.assert(response.status === 409, "Esperado 409");
  client.assert(response.body.codigo === "CONFLITO_IDEMPOTENCIA", "Esperado CONFLITO_IDEMPOTENCIA");
});
%}

### Horário já ocupado responde 409
POST {{baseUrl}}/api/v1/publico/agendamentos
Content-Type: application/json
Chave-Idempotencia: {{chaveConflito}}

{
  "servicoId": "{{servicoId}}",
  "inicioEm": "{{segunda}}T09:00:00-03:00",
  "cliente": {
    "nome": "Outro Cliente",
    "celular": "{{celularBalcao}}"
  },
  "versaoAvisoPrivacidade": "{{versaoAvisoPrivacidade}}",
  "cienteAvisoPrivacidade": true
}

> {%
client.test("Conflito de agenda", function () {
  client.assert(response.status === 409, "Esperado 409");
  client.assert(response.body.codigo === "CONFLITO_AGENDAMENTO", "Esperado CONFLITO_AGENDAMENTO");
});
%}

### Aviso de privacidade desatualizado responde 409
POST {{baseUrl}}/api/v1/publico/agendamentos
Content-Type: application/json
Chave-Idempotencia: {{chaveAviso}}

{
  "servicoId": "{{servicoId}}",
  "inicioEm": "{{segunda}}T11:00:00-03:00",
  "cliente": {
    "nome": "Cliente Exemplo",
    "celular": "{{celularPublico}}"
  },
  "versaoAvisoPrivacidade": "versao-anterior",
  "cienteAvisoPrivacidade": true
}

> {%
client.test("Aviso desatualizado", function () {
  client.assert(response.status === 409, "Esperado 409");
  client.assert(response.body.codigo === "AVISO_PRIVACIDADE_DESATUALIZADO", "Esperado aviso desatualizado");
});
%}

### 6. Criar reserva administrativa
POST {{baseUrl}}/api/v1/administracao/agendamentos
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}
Chave-Idempotencia: {{chaveAdministrativa}}

{
  "servicoId": "{{servicoId}}",
  "inicioEm": "{{segunda}}T10:30:00-03:00",
  "cliente": {
    "nome": "Cliente Balcao",
    "celular": "{{celularBalcao}}"
  },
  "versaoAvisoPrivacidade": "{{versaoAvisoPrivacidade}}",
  "cienteAvisoPrivacidade": true
}

> {%
client.test("Reserva administrativa", function () {
  client.assert(response.status === 201, "Esperado 201");
  client.assert(response.body.origem === "ADMINISTRACAO", "Esperado ADMINISTRACAO");
  client.assert(response.headers.valueOf("Location") !== null, "Esperado Location");
});
client.global.set("agendamentoId", response.body.id);
client.global.set("clienteId", response.body.cliente.id);
%}

### Criação administrativa também respeita conflitos
POST {{baseUrl}}/api/v1/administracao/agendamentos
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}
Chave-Idempotencia: {{chaveAdministrativaConflito}}

{
  "servicoId": "{{servicoId}}",
  "inicioEm": "{{segunda}}T10:30:00-03:00",
  "cliente": {
    "nome": "Outro Cliente",
    "celular": "{{celularPublico}}"
  },
  "versaoAvisoPrivacidade": "{{versaoAvisoPrivacidade}}",
  "cienteAvisoPrivacidade": true
}

> {%
client.test("Conflito administrativo", function () {
  client.assert(response.status === 409, "Esperado 409");
  client.assert(response.body.codigo === "CONFLITO_AGENDAMENTO", "Esperado CONFLITO_AGENDAMENTO");
});
%}

