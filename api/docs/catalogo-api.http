### Consultar disponibilidade pública
GET {{baseUrl}}/api/v1/publico/servicos/{{servicoId}}/disponibilidade?dataInicial={{segunda}}&dataFinal={{domingo}}

> {%
client.test("Disponibilidade", function () {
  client.assert(response.status === 200, "Esperado 200");
  client.assert(response.body.dias[0].horarios[0].inicioEm.indexOf("T09:00:00-03:00") > 0, "Esperado inicio as 9h");
});
%}

### Consultar aviso de privacidade
GET {{baseUrl}}/api/v1/publico/aviso-privacidade

> {%
