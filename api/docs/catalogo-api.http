### Validação de campos responde 422 com errosCampos
POST {{baseUrl}}/api/v1/administracao/servicos
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{
  "profissionalId": "{{profissionalId}}",
  "nome": "",
  "duracaoMinutos": 0,
  "intervaloLimpezaMinutos": 0,
  "preco": 120.00,
  "ativo": true,
  "ordemExibicao": 0,
  "requisitosRecursos": []
}

> {%
client.test("Validacao", function () {
  client.assert(response.status === 422, "Esperado 422");
  client.assert(response.body.codigo === "FALHA_VALIDACAO", "Esperado FALHA_VALIDACAO");
  client.assert(response.body.errosCampos.length === 2, "Esperados dois campos invalidos");
});
%}

### Criar serviço
POST {{baseUrl}}/api/v1/administracao/servicos
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{
  "profissionalId": "{{profissionalId}}",
  "nome": "Serviço Exemplo",
  "descricao": "Descrição pública opcional",
  "duracaoMinutos": 60,
  "intervaloLimpezaMinutos": 0,
  "preco": 120.00,
  "ativo": true,
  "ordemExibicao": 0,
  "requisitosRecursos": [
    {
      "recursoId": "{{recursoId}}",
      "quantidade": 1
    }
  ]
}

> {%
client.test("Servico criado", function () {
  client.assert(response.status === 201, "Esperado 201");
});
client.global.set("servicoId", response.body.id);
%}

### 3. Substituir expediente semanal
PUT {{baseUrl}}/api/v1/administracao/agenda/semanal
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{
  "profissionalId": "{{profissionalId}}",
  "janelas": [
    {"diaSemana": "SEGUNDA_FEIRA", "inicio": "09:00", "fim": "12:00"},
    {"diaSemana": "SEGUNDA_FEIRA", "inicio": "13:00", "fim": "18:00"}
  ]
}

> {%
client.test("Expediente", function () {
  client.assert(response.status === 200, "Esperado 200");
  client.assert(response.body.janelas.length === 2, "Esperadas duas janelas");
});
%}

