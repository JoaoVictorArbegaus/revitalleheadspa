@baseUrl = http://localhost:8080
@email = proprietario@example.test
@senha = substitua-por-uma-senha-local

# Exemplos executáveis pelo IntelliJ HTTP Client, na ordem do arquivo, contra uma
# instalação local com dados fictícios. Datas, chaves de idempotência, celulares e
# emails são gerados a cada execução; o arquivo pode ser executado mais de uma vez.

### 1. Sem sessão, a área administrativa responde 401
< {%
const base = new Date(Date.now() + 2 * 86400000);
while (base.getUTCDay() !== 1) {
  base.setUTCDate(base.getUTCDate() + 1);
}
const dia = (deslocamento) => new Date(base.getTime() + deslocamento * 86400000).toISOString().slice(0, 10);
const sufixo = Date.now().toString() + Math.floor(Math.random() * 1000).toString().padStart(3, "0");
client.global.set("segunda", dia(0));
client.global.set("domingo", dia(6));
client.global.set("sufixo", sufixo);
client.global.set("celularPublico", "(11) 9" + sufixo.slice(-8, -4) + "-" + sufixo.slice(-4));
client.global.set("celularBalcao", "+55 21 9" + sufixo.slice(-8));
client.global.set("chavePublica", "publica-" + sufixo);
client.global.set("chaveConflito", "conflito-" + sufixo);
client.global.set("chaveAviso", "aviso-" + sufixo);
client.global.set("chaveAdministrativa", "administrativa-" + sufixo);
client.global.set("chaveAdministrativaConflito", "administrativa-conflito-" + sufixo);
client.global.set("chaveBloqueada", "administrativa-bloqueada-" + sufixo);
%}
GET {{baseUrl}}/api/v1/administracao/autenticacao/eu

> {%
client.test("Sem sessao", function () {
  client.assert(response.status === 401, "Esperado 401");
});
%}

### Obter CSRF e cookies
GET {{baseUrl}}/api/v1/administracao/autenticacao/csrf

> {% client.global.set("csrf", response.body.token); %}

### Entrar como proprietário
POST {{baseUrl}}/api/v1/administracao/autenticacao/entrar
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{
  "email": "{{email}}",
  "senha": "{{senha}}"
}

> {%
client.test("Login", function () {
  client.assert(response.status === 204, "Esperado 204");
});
%}

### Consultar a identidade atual
GET {{baseUrl}}/api/v1/administracao/autenticacao/eu

> {%
client.test("Identidade", function () {
  client.assert(response.status === 200, "Esperado 200");
  client.assert(response.body.papel === "PROPRIETARIO", "Esperado PROPRIETARIO");
});
%}

### 2. Escrita sem X-CSRF-TOKEN responde 403
POST {{baseUrl}}/api/v1/administracao/profissionais
Content-Type: application/json

{
  "nome": "Sem CSRF",
  "ativo": true
}

> {%
client.test("CSRF obrigatorio", function () {
  client.assert(response.status === 403, "Esperado 403");
  client.assert(response.body.codigo === "FALHA_VALIDACAO_CSRF", "Esperado FALHA_VALIDACAO_CSRF");
});
%}

### Criar profissional
POST {{baseUrl}}/api/v1/administracao/profissionais
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{
  "nome": "Profissional Exemplo",
  "ativo": true
}

> {%
client.test("Profissional criado", function () {
  client.assert(response.status === 201, "Esperado 201");
});
client.global.set("profissionalId", response.body.id);
%}

