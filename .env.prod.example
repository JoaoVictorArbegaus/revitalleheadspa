# Identificador imutável da release (normalmente o commit curto).
RELEASE_ID=

# Banco exclusivo da Revitalle. Use uma senha aleatória longa.
DATABASE_PASSWORD=

# Proprietária criada somente quando ainda não existe usuário administrativo.
# Depois do primeiro acesso, esvazie BOOTSTRAP_PROPRIETARIO_SENHA e recrie apenas a API.
BOOTSTRAP_PROPRIETARIO_NOME=Marineuza Branco
BOOTSTRAP_PROPRIETARIO_EMAIL=
BOOTSTRAP_PROPRIETARIO_SENHA=

# Aviso exibido e registrado no fluxo público de agendamento.
NEGOCIO_VERSAO_AVISO_PRIVACIDADE=
NEGOCIO_TEXTO_AVISO_PRIVACIDADE=
