@baseUrl = http://localhost:8080
@email = proprietario@example.test
@senha = substitua-por-uma-senha-local

### Obter CSRF e cookies
GET {{baseUrl}}/api/v1/administracao/autenticacao/csrf

> {% client.global.set("csrf", response.body.token); %}

### Entrar
POST {{baseUrl}}/api/v1/administracao/autenticacao/entrar
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{
  "email": "{{email}}",
  "senha": "{{senha}}"
}

### Criar profissional
POST {{baseUrl}}/api/v1/administracao/profissionais
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{
  "nome": "Profissional Exemplo",
  "ativo": true
}

> {% client.global.set("profissionalId", response.body.id); %}

### Criar recurso
POST {{baseUrl}}/api/v1/administracao/recursos
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{
  "nome": "Sala Exemplo",
  "capacidade": 1,
  "ativo": true
}

> {% client.global.set("recursoId", response.body.id); %}

### Criar serviço
POST {{baseUrl}}/api/v1/administracao/servicos
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{
  "profissionalId": "{{profissionalId}}",
  "nome": "Serviço Exemplo",
  "descricao": "Descrição pública opcional",
  "duracaoMinutos": 60,
  "intervaloLimpezaMinutos": 0,
  "preco": 120.00,
  "ativo": true,
  "ordemExibicao": 0,
  "requisitosRecursos": [
    {
      "recursoId": "{{recursoId}}",
      "quantidade": 1
    }
  ]
}

> {% client.global.set("servicoId", response.body.id); %}

### Catálogo público
GET {{baseUrl}}/api/v1/publico/servicos

### Substituir expediente semanal
PUT {{baseUrl}}/api/v1/administracao/agenda/semanal
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{
  "profissionalId": "{{profissionalId}}",
  "janelas": [
    {"diaSemana": "SEGUNDA_FEIRA", "inicio": "09:00", "fim": "12:00"},
    {"diaSemana": "SEGUNDA_FEIRA", "inicio": "13:00", "fim": "18:00"}
  ]
}

### Consultar expediente semanal
GET {{baseUrl}}/api/v1/administracao/agenda/semanal?profissionalId={{profissionalId}}

### Criar bloqueio
POST {{baseUrl}}/api/v1/administracao/agenda/bloqueios
Content-Type: application/json
X-CSRF-TOKEN: {{csrf}}

{
  "profissionalId": "{{profissionalId}}",
  "inicioEm": "2026-10-12T13:00:00-03:00",
  "fimEm": "2026-10-12T14:00:00-03:00"
}

> {% client.global.set("bloqueioId", response.body.id); %}

### Listar bloqueios
GET {{baseUrl}}/api/v1/administracao/agenda/bloqueios?profissionalId={{profissionalId}}&dataInicial=2026-10-01&dataFinal=2026-10-31

### Consultar disponibilidade pública
GET {{baseUrl}}/api/v1/publico/servicos/{{servicoId}}/disponibilidade?dataInicial=2026-10-12&dataFinal=2026-10-18

### Remover bloqueio
DELETE {{baseUrl}}/api/v1/administracao/agenda/bloqueios/{{bloqueioId}}
X-CSRF-TOKEN: {{csrf}}
